{
  "name": "proofpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-corpus.ts",
    "generate:ext": "bun scripts/generate-extensions-corpus.ts",
    "generate:l2": "bun scripts/generate-l2-content.ts",
    "generate:l2-messages": "bun scripts/generate-l2-messages.ts",
    "generate:wording-candidates": "bun scripts/generate-wording-candidates.ts",
    "test": "bun test",
    "harness": "bun test tests/corpus-harness.test.ts tests/l2-harness.test.ts",
    "eval": "bun scripts/eval/run.ts",
    "eval:check": "bun scripts/eval/run.ts --check",
    "eval:fresh": "python3 scripts/eval/generate_fresh.py",
    "check": "bunx tsc --noEmit",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "e2e": "bun e2e/responsive.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
